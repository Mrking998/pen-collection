{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pen-collection",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "pencollection.org",
      "custom_domain": true
    },
    {
      "pattern": "www.pencollection.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pen-collection-db",
      "database_id": "56dc6606-082f-4025-887a-5e29ea696654",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "pen-collection-images"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
