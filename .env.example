# ── Database ──────────────────────────────────────────────
# Auto-filled by Vercel when you attach a Vercel Postgres (or Neon) database
# to this project. You should not need to set this by hand.
POSTGRES_URL=

# ── Admin panel (/admin.html) ────────────────────────────
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Contact-form notification email ──────────────────────
ADMIN_EMAIL=jacket.md@gmail.com

# ── Resend (resend.com) — sends the contact-form email ───
RESEND_API_KEY=
FROM_EMAIL=Pen Collection <onboarding@resend.dev>

# ── Paystack (paystack.com dashboard > Settings > API Keys & Webhooks) ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
